# Copy the needed entries into the deployment's private .env. Never commit it.
# Identity/name/signature are entered in /sender-profiles, NOT in this file.
# Each MAIL_USERNAME and IMAP_USERNAME must equal that profile's sender_email.
# Populate YOUR provider's hosts; aliases and shared relay credentials unsupported.

SENDER_WEBS_MAIL_SERVER=
SENDER_WEBS_MAIL_PORT=465
SENDER_WEBS_MAIL_USE_SSL=true
SENDER_WEBS_MAIL_USE_TLS=false
SENDER_WEBS_MAIL_USERNAME=
SENDER_WEBS_MAIL_PASSWORD=
SENDER_WEBS_IMAP_SERVER=
SENDER_WEBS_IMAP_PORT=993
SENDER_WEBS_IMAP_USERNAME=
SENDER_WEBS_IMAP_PASSWORD=

SENDER_ELEKTRO_MAIL_SERVER=
SENDER_ELEKTRO_MAIL_PORT=465
SENDER_ELEKTRO_MAIL_USE_SSL=true
SENDER_ELEKTRO_MAIL_USE_TLS=false
SENDER_ELEKTRO_MAIL_USERNAME=
SENDER_ELEKTRO_MAIL_PASSWORD=
SENDER_ELEKTRO_IMAP_SERVER=
SENDER_ELEKTRO_IMAP_PORT=993
SENDER_ELEKTRO_IMAP_USERNAME=
SENDER_ELEKTRO_IMAP_PASSWORD=

SENDER_MG_STAV_MAIL_SERVER=
SENDER_MG_STAV_MAIL_PORT=465
SENDER_MG_STAV_MAIL_USE_SSL=true
SENDER_MG_STAV_MAIL_USE_TLS=false
SENDER_MG_STAV_MAIL_USERNAME=
SENDER_MG_STAV_MAIL_PASSWORD=
SENDER_MG_STAV_IMAP_SERVER=
SENDER_MG_STAV_IMAP_PORT=993
SENDER_MG_STAV_IMAP_USERNAME=
SENDER_MG_STAV_IMAP_PASSWORD=
