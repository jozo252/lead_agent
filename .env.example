APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///leads.db

# Hostinger Mail: use port 465 + SSL, or port 587 + TLS.
MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=your-mailbox@example.com
MAIL_PASSWORD=replace-me
MAIL_DEFAULT_SENDER=your-mailbox@example.com
IMAP_SERVER=imap.hostinger.com
IMAP_PORT=993
IMAP_USERNAME=your-mailbox@example.com
IMAP_PASSWORD=replace-me

OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
BRAVE_API_KEY=replace-me
PUBLIC_BASE_URL=https://lead.example.com

LANDING_OPERATOR_NAME=
LANDING_OPERATOR_ADDRESS=
LANDING_OPERATOR_ICO=
LANDING_OPERATOR_PHONE=
LANDING_OPERATOR_REGISTER=

# Read/write access for ChatGPT Work batch enrichment only.
WORK_API_TOKEN=replace-with-a-separate-long-random-value

# Private app token. HubSpot calls run only after a user confirms a POST action.
HUBSPOT_ACCESS_TOKEN=replace-me
HUBSPOT_API_BASE=https://api.hubapi.com
